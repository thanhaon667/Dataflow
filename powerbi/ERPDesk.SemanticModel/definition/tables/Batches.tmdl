	measure 'Rows Loaded' = SUM(Batches[rows_in])
		formatString: #,0
		lineageTag: 67ed673c-c8e5-5e83-b188-4ba956d15d24

	measure 'Rows Kept' = SUM(Batches[rows_kept])
		formatString: #,0
		lineageTag: 60ee1b35-bca8-5efd-bece-991f93376539

	measure 'Rows Removed' = SUM(Batches[rows_bad]) + SUM(Batches[rows_dup]) + SUM(Batches[rows_spam])
		formatString: #,0
		lineageTag: 82b02860-aaec-5a29-8fb8-315f24342f2c

	partition Batches = m
		mode: directQuery
		source =
				let
				    Source = PostgreSQL.Database(PgServer, PgDatabase),
				    Data = Source{[Schema = "public", Item = "pbi_social_batch"]}[Data]
				in
				    Data
