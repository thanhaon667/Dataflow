# Copy this file to .env and fill in the real password (.env is already in .gitignore)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=erp_support
DB_USER=erp_app
DB_PASSWORD=changeme

# ClickUp (fill in once you have a real token; leave blank to run in mock mode)
CLICKUP_API_TOKEN=
CLICKUP_LIST_ID=

# DeepSeek (fill in once you have a real key; leave blank to run in mock/fallback mode)
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com

# Email alerts - Script Center "email me on failure" + the daily digest (erp/daily_digest.py).
# Leave SMTP_HOST blank to disable sending (skips silently with a log warning).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# ERP Desk (local desktop app shell, see README). All optional - defaults shown.
# Preferred ports (127.0.0.1 only); a free port is picked automatically if one is taken.
DESKTOP_PORT=47650
DESKTOP_STREAMLIT_PORT=47651
# How often the live report re-queries the database (seconds, minimum 3)
DESKTOP_REFRESH_SECONDS=10
# 1 = generate today's daily digest automatically (once per day) while the app is open.
# Uses one AI call, never sends email (the scheduled run_daily_digest.bat is what emails).
DESKTOP_AUTO_DIGEST=1
