	column reply_bucket
		dataType: string
		lineageTag: df592894-1624-5670-9690-2b0620c79e9c
		summarizeBy: none
		sourceColumn: reply_bucket

	column sla_status
		dataType: string
		lineageTag: a9c11fcd-7983-5795-942a-a591d9667595
		summarizeBy: none
		sourceColumn: sla_status

	measure 'Lead Count' = COUNTROWS(Leads)
		formatString: #,0
		lineageTag: 7046d452-9d4a-5dd0-afa6-cb6bb9e4270c

	measure 'Replied in Time' = CALCULATE([Lead Count], Leads[sla_status] = "Replied in time")
		formatString: #,0
		lineageTag: 98841782-6ef9-5302-aee3-556c0cbdb2b6

	measure 'Replied Late' = CALCULATE([Lead Count], Leads[sla_status] = "Replied late")
		formatString: #,0
		lineageTag: 15c9d278-5f96-50d8-b7ed-13cc83b7e9cf

	measure 'Waiting Past SLA' = CALCULATE([Lead Count], Leads[sla_status] = "Waiting, past SLA")
		formatString: #,0
		lineageTag: 20f32676-7394-5722-8e6c-21a3444cb344

	measure 'Waiting In Time' = CALCULATE([Lead Count], Leads[sla_status] = "Waiting, in time")
		formatString: #,0
		lineageTag: b6610f7f-73e7-5b37-97b5-317c429b18b0

	measure 'SLA Met %' = DIVIDE([Replied in Time], [Replied in Time] + [Replied Late] + [Waiting Past SLA])
		formatString: 0.0%
		lineageTag: d218b07d-18a4-58aa-99c9-ba36ebc732ed

	measure 'Median Reply Minutes' = MEDIAN(Leads[reply_minutes])
		formatString: #,0
		lineageTag: 56e2bd9b-f9e1-5975-883e-e3367b013a45

	measure 'Avg Potential Score' = AVERAGE(Leads[potential_score])
		formatString: 0.0
		lineageTag: 0cea6152-f471-5016-b978-fca08649bdab

	measure 'Leads Previous Month' = CALCULATE([Lead Count], DATEADD('Calendar'[date], -1, MONTH))
		formatString: #,0
		lineageTag: 5c2cbdb2-151b-5e91-a20f-0085baa011d1

	measure 'Leads vs Previous Month' = DIVIDE([Lead Count] - [Leads Previous Month], [Leads Previous Month])
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: a21b378c-44ac-5feb-89a5-c3d32c073968

	partition Leads = m
		mode: directQuery
		source =
				let
				    Source = PostgreSQL.Database(PgServer, PgDatabase),
				    Data = Source{[Schema = "public", Item = "pbi_leads"]}[Data]
				in
				    Data
